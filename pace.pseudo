DECLARE jarak : REAL            // satuan km
DECLARE waktu : REAL            // satuan min
DECLARE pace : REAL             // satuan min/km
DECLARE speed : REAL            // satuan km/jam
DECLARE lihatPaceSaja : BOOLEAN
INPUT jarak
INPUT waktu
INPUT lihatSpeed

pace <- waktu / jarak

IF lihatPaceSaja = TRUE THEN
    OUTPUT pace
ELSE
    speed <- 60 / pace
    OUTPUT speed, pace
ENDIF